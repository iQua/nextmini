FROM rust:1.70

RUN apt-get update && apt-get install -y \
    build-essential \
    clang \
    llvm \
    libbpf-dev \
    linux-headers-generic \
    linux-libc-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Cargo.toml .
COPY src/ src/
COPY sockmap_redirect.c .
COPY sockmap_loader.c .
COPY Makefile .
COPY vmlinux.h .
COPY start-client.sh .
COPY simple_test.c .
COPY test_loader.c .

RUN cargo build --release --bin client
RUN make
RUN chmod +x start-client.sh

EXPOSE 8080

CMD ["./start-client.sh"]