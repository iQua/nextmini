# Local DigitalOcean config for examples/fec/deploy.sh and cleanup.sh
DO_SSH_PUBLIC_KEY_PATH="$HOME/.ssh/no-key.pub"
DO_SSH_KEY_NAME=""

DO_DROPLET_SIZE="" # shared 4cpus
DO_DROPLET_IMAGE=""
DO_DROPLET_TAGS=""
# Space-separated droplet specs in the format "name:region".
# In DO: tor1 = Toronto, fra1 = Frankfurt, sgp1 = Singapore
DO_NODES=""
