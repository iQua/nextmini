FROM alpine:latest

RUN apk add --no-cache wget proxychains-ng

WORKDIR /app

COPY src/client.sh /usr/local/bin/client.sh
RUN chmod +x /usr/local/bin/client.sh \
  && mkdir -p /var/nextmini \
  && ln -s /usr/local/bin/client.sh /var/nextmini/src

# write a clean proxychains.conf
RUN cat > /etc/proxychains.conf <<'EOF'
strict_chain
proxy_dns
quiet_mode
[ProxyList]
socks5 172.16.8.5 8081
EOF

# debug: print the file we just created
RUN cat /etc/proxychains.conf

# debug: check proxychains version and test config
RUN proxychains4 --version || true
RUN proxychains4 -f /etc/proxychains.conf echo "config test" || true

CMD ["/usr/local/bin/client.sh"]