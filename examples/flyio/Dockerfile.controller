# Build optimized Dockerfile using cargo-chef for layer caching
# Use Alpine with musl for smaller image and no GLIBC issues
FROM rust:alpine AS chef
RUN apk add --no-cache musl-dev pkgconf openssl-dev openssl-libs-static
RUN cargo install cargo-chef
WORKDIR /app

# Planner stage - analyze dependencies
FROM chef AS planner
COPY Cargo.toml Cargo.lock ./
COPY messages ./messages
COPY controller ./controller
COPY dataplane ./dataplane
COPY cert-gen ./cert-gen
RUN cargo chef prepare --recipe-path recipe.json

# Builder stage - build dependencies and application
FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json

# Install build dependencies for Alpine
RUN apk add --no-cache musl-dev pkgconf openssl-dev openssl-libs-static

# Build dependencies - this is the caching Docker layer!
RUN cargo chef cook --release --recipe-path recipe.json

# Build application
COPY Cargo.toml Cargo.lock ./
COPY messages ./messages
COPY controller ./controller
COPY dataplane ./dataplane
COPY cert-gen ./cert-gen

# Generate TLS certificates
RUN cargo run --release -p cert-gen

# Build controller
RUN cargo build --release -p controller

# Runtime stage - minimal Alpine image
FROM alpine:latest AS runtime
WORKDIR /app

# Install runtime dependencies
RUN apk add --no-cache ca-certificates libgcc

# Copy controller binary and certificates
COPY --from=builder /app/target/release/controller /usr/local/bin/controller
COPY --from=builder /app/server_cert.pem /app/server_cert.pem
COPY --from=builder /app/server_key.pem /app/server_key.pem

# Config file will be mounted at runtime via fly.toml [files] section

ENV RUST_LOG=info

EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/controller"]

