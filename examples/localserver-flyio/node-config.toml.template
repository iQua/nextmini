# Fly.io network interface (usually eth0)
private_network_interface = "eth0"
private_network_name = "flynet"
num_tun_queues = 1
num_packet_processors = 4
channel_capacity = 4000
queue_capacity = 3000
feature = "concurrent"

# Controller address - points to external server
# This will be replaced by deploy-flyio.py with actual public IP
controller_addr = "ws://{{PUBLIC_IP}}:3000"

# Node ID - will be set differently for each node by deploy-flyio.py
node_id = {{NODE_ID}}
public_network_port = "8080"
