# Build optimized Dockerfile using cargo-chef for layer caching
# Use Alpine with musl for smaller image and no GLIBC issues
FROM rust:alpine AS chef
RUN apk add --no-cache musl-dev pkgconf openssl-dev openssl-libs-static
RUN cargo install cargo-chef
WORKDIR /app

# Planner stage - analyze dependencies
FROM chef AS planner
COPY Cargo.toml Cargo.lock ./
COPY messages ./messages
COPY controller ./controller
COPY dataplane ./dataplane
COPY cert-gen ./cert-gen
RUN cargo chef prepare --recipe-path recipe.json

# Builder stage - build dependencies and application
FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json

# Install build dependencies for Alpine
RUN apk add --no-cache musl-dev pkgconf openssl-dev openssl-libs-static

# Build dependencies - this is the caching Docker layer!
RUN cargo chef cook --release --recipe-path recipe.json

# Build application
COPY Cargo.toml Cargo.lock ./
COPY messages ./messages
COPY controller ./controller
COPY dataplane ./dataplane
COPY cert-gen ./cert-gen
COPY examples/localserver-flyio/ring-emu ./ring-emu

RUN cargo build --release -p nextmini
RUN cargo build --release --manifest-path ring-emu/Cargo.toml

# Runtime stage - minimal Alpine image with TUN support
FROM alpine:latest AS runtime
WORKDIR /app

# Install runtime dependencies
RUN apk add --no-cache ca-certificates libgcc iproute2 iptables

# Copy dataplane binary
COPY --from=builder /app/target/release/nextmini /usr/local/bin/nextmini

# Copy ringallreduce binary for testing
COPY --from=builder /app/ring-emu/target/release/ringallreduce /usr/local/bin/ringallreduce

# Prepare ring-test directory and files (avoid runtime SSH copy)
RUN mkdir -p /tmp/ring-test
COPY examples/localserver-flyio/ring-emu/ring.txt /tmp/ring-test/ring.txt

# Config file will be mounted at runtime via fly.toml [files] section

ENV RUST_LOG=info

EXPOSE 8080

# Run nextmini dataplane (ringallreduce launched via SSH)
ENTRYPOINT ["/usr/local/bin/nextmini"]
