# Use the official Rust image, which includes Rust, Cargo, and a Debian-based OS.
FROM rust:1.87

# Install the curl command-line tool, which our Rust program will execute.
RUN apt-get update && apt-get install -y curl

# Set the working directory.
WORKDIR /app

# Copy the Cargo configuration file.
COPY Cargo.toml .

# Copy the source code.
COPY src ./src

# Build the client application using Cargo.
# This will handle dependencies like tokio and tokio-splice automatically.
RUN cargo build --release --bin client

# Set the command to run when the container starts.
# The binary is located in the target/release directory.
CMD ["/app/target/release/client"]